<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nuvloc</ToolCommandName>
    <IsPackable>true</IsPackable>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>NuvyntraLabs.NuvLoc.Cli</RootNamespace>
    <AssemblyName>NuvyntraLabs.NuvLoc.Cli</AssemblyName>
    <PackageId>NuvyntraLabs.NuvLoc.Cli</PackageId>
    <Title>nuvloc — agent-driven localization for sibling .resx hosts</Title>
    <Description>dotnet tool that checks i18n.json, diffs .resx culture files, and installs /nuvloc.translate and /nuvloc.status for your coding agent. The agent translates; NuvLoc does not call a vendor API.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>1.1.0: maui, wpf, winui, avalonia, and uno sibling .resx hosts. Same adapter and path rule. No API keys. Native-language review required.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\payload\**\*" Link="payload\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NuvLoc.Core\NuvLoc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
  </ItemGroup>

</Project>
